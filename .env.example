# REST API base URL (no trailing slash)
# Default when unset: http://localhost:3001
VITE_API_URL=http://localhost:3001

# WebSocket URL for live sensor data
# Default when unset: wss://sis-sse.onrender.com
VITE_WS_URL=ws://localhost:4000

# Set to "REST" to poll HTTP endpoints instead of WebSocket
# Default when unset: WS (WebSocket)
VITE_DATA_SOURCE=WS

# Alternative SSE/REST base URL (used when VITE_DATA_SOURCE=REST)
VITE_SSE_REST_URL=http://localhost:3001
